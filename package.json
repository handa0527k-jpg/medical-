{
  "name": "medstudy-histology",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:narration": "tsx scripts/build-narration.ts",
    "check:content": "tsx scripts/check-content.ts && tsx scripts/build-stats.ts --check",
    "build:stats": "tsx scripts/build-stats.ts",
    "new:course": "tsx scripts/new-course.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "kuromoji": "^0.1.2",
    "pdfjs-dist": "^6.3.289",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
