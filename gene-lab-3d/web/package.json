{
  "name": "gene-lab-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:hosted": "tsc --noEmit && VITE_MODELS_JSON=1 vite build && node scripts/hosted-models.mjs dist/models dist/film/models",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "kit": "blender -b --factory-startup --python ../blender/build.py -- public/models/kit.glb",
    "renders": "blender -b --factory-startup --python ../blender/render.py -- public/renders",
    "film:stills": "node scripts/render-film.mjs sanger --stills",
    "film:render": "node scripts/render-film.mjs sanger"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.1",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
